{
    "name": "paintdotjs-plugins",
    "version": "0.1.0",
    "private": true,
    "description": "Maintained JavaScript plugins for paint.js",
    "workspaces": [
        "plugins/*"
    ],
    "scripts": {
        "build": "node scripts/build.cjs",
        "dev": "node scripts/dev.cjs",
        "format": "prettier --write \"plugins/*/plugin.js\""
    },
    "devDependencies": {
        "esbuild": "^0.28.2",
        "fflate": "0.8.3",
        "prettier": "^3.9.10"
    }
}
